# CoPassage — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.

# ── Supabase ─────────────────────────────────────────────────────────────────
# Found at: https://supabase.com/dashboard/project/<project-id>/settings/api

# The public URL of your Supabase project
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co

# The public (anon) API key — safe to expose in the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>

# The secret service-role key — NEVER expose in the browser
# Used only in trusted server-side code (Server Actions, Route Handlers)
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
