# =============================================================================
# CoPassage — Environment Variables Template
# =============================================================================
# Copy this file to .env and provide your actual credentials before running:
# cp .env.example .env
# NEVER commit your actual .env file to git!

# ── Firebase Authentication (Phone OTP) ──────────────────────────────────────
# Obtain these from your Firebase Console under Project Settings -> General -> Your Apps
VITE_FIREBASE_API_KEY="your_firebase_api_key"
VITE_FIREBASE_AUTH_DOMAIN="your_project_id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your_firebase_project_id"
VITE_FIREBASE_STORAGE_BUCKET="your_project_id.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="your_messaging_sender_id"
VITE_FIREBASE_APP_ID="your_firebase_app_id"
VITE_FIREBASE_MEASUREMENT_ID="your_firebase_measurement_id"

# ── Supabase (PostgreSQL & Realtime) ──────────────────────────────────────────
# Obtain these from your Supabase Dashboard under Project Settings -> API
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your_supabase_anon_public_key"

# ── Razorpay Payment Gateway (Test Mode) ──────────────────────────────────────
# Obtain these from your Razorpay Dashboard under Settings -> API Keys
VITE_RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_secret_key"

# ── AI Integration & Application URL ──────────────────────────────────────────
# Google Gemini API key for intelligent route reasoning and support features
GEMINI_API_KEY="your_gemini_api_key"

# Base URL for local development or production deployment
APP_URL="http://localhost:3000"
